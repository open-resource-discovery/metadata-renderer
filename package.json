{
    "name": "@open-resource-discovery/metadata-renderer",
    "version": "1.1.0",
    "description": "React components that render OpenAPI, CSN, AsyncAPI, A2A, and MCP metadata documents.",
    "author": "SAP SE",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/open-resource-discovery/metadata-renderer"
    },
    "keywords": [
        "metadata",
        "renderer",
        "react",
        "openapi",
        "swagger",
        "csn",
        "asyncapi",
        "a2a",
        "mcp"
    ],
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "type": "module",
    "scarfSettings": {
        "enabled": false
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./openapi": {
            "types": "./dist/entries/openapi.d.ts",
            "import": "./dist/openapi.js",
            "default": "./dist/openapi.js"
        },
        "./csn": {
            "types": "./dist/entries/csn.d.ts",
            "import": "./dist/csn.js",
            "default": "./dist/csn.js"
        },
        "./asyncapi": {
            "types": "./dist/entries/asyncapi.d.ts",
            "import": "./dist/asyncapi.js",
            "default": "./dist/asyncapi.js"
        },
        "./a2a": {
            "types": "./dist/entries/a2a.d.ts",
            "import": "./dist/a2a.js",
            "default": "./dist/a2a.js"
        },
        "./mcp": {
            "types": "./dist/entries/mcp.d.ts",
            "import": "./dist/mcp.js",
            "default": "./dist/mcp.js"
        },
        "./overlay": {
            "types": "./dist/entries/overlay.d.ts",
            "import": "./dist/overlay.js",
            "default": "./dist/overlay.js"
        },
        "./styles": {
            "types": "./dist/styles.d.ts",
            "default": "./dist/index.css"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "generate:overlay-styles": "node scripts/generate-overlay-code-styles.mjs",
        "prebuild": "npm run generate:overlay-styles",
        "build": "tsc -b && vite build --mode lib",
        "build:lib:watch": "vite build --mode lib --watch",
        "build:demo": "vite build",
        "website:start": "npm --prefix website run start",
        "website:build": "npm --prefix website run build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "npm run eslint:ci",
        "eslint": "eslint . --fix",
        "eslint:ci": "eslint .",
        "prettier": "prettier --write .",
        "prettier:ci": "prettier --check .",
        "format": "npm run prettier && npm run eslint",
        "format:check": "npm run prettier:ci && npm run eslint:ci",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "@asyncapi/react-component": "^3.1.3",
        "@open-resource-discovery/a2a-editor": "^0.4.2",
        "@open-resource-discovery/mcp-server-card-ui": "0.2.1",
        "@open-resource-discovery/overlay-editor": "^0.2.0",
        "@sap/csn-interop-renderer": "0.5.0",
        "@scalar/api-reference-react": "^0.9.54",
        "@scalar/react-renderer": "^0.4.1",
        "@scalar/types": "^0.16.2",
        "react-error-boundary": "^6.0.0",
        "react-markdown": "^10.1.0",
        "yaml": "^2.8.1"
    },
    "overrides": {
        "dompurify": ">=3.4.12",
        "fast-uri": ">=3.1.5",
        "undici": ">=7.29.0 <8",
        "postcss": ">=8.5.23",
        "brace-expansion": ">=1.1.18"
    },
    "devDependencies": {
        "@sap/eslint-config": "0.5.2",
        "@shikijs/themes": "^4.4.3",
        "@types/node": "24.13.3",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.5",
        "eslint": "10.6.0",
        "jsdom": "29.1.1",
        "jsonc-eslint-parser": "3.1.0",
        "prettier": "3.9.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "typescript": "5.9.3",
        "vite": "8.1.5",
        "vite-plugin-dts": "4.5.4",
        "vitest": "3.2.7"
    }
}

{
  "printWidth": 120,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 4,
  "semi": true,
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore",
  "sortPackageJson": false,
  "ignorePatterns": [
    "/dist",
    "/dist-demo",
    "/coverage",
    "/.nx/cache",
    "/.nx/workspace-data",
    "/website/build",
    "/website/.docusaurus",
    "/drafts",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-*/**",
    "**/.test-dist/**",
    "**/reports/**",
    "**/coverage/**",
    "**/.next/**",
    "**/build/**",
    "**/.docusaurus/**",
    "**/vendor/**",
    "**/generated/**",
    "**/examples/**",
    "**/fixtures/**",
    "**/original-schema/**",
    "**/__snapshots__/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/storybook-static/**",
    "**/.vscode-test/**",
    "**/resources/**",
    "**/test-data/**",
    "**/testdata/**",
    "**/.github/**",
    "**/example/**",
    "**/test-files/**",
    "**/schemas/**",
    "**/static/**",
    "**/res/**",
    "**/pnpm-lock.yaml",
    "**/package-lock.json"
  ],
  "proseWrap": "preserve"
}

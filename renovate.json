{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["group:definitelyTyped"],
    "timezone": "Europe/Berlin",
    "prConcurrentLimit": 20,
    "automerge": true,
    "platformAutomerge": true,
    "lockFileMaintenance": { "enabled": true },
    "schedule": ["every weekend"],
    "packageRules": [
        {
            "matchPackageNames": [
                "@asyncapi/react-component",
                "@open-resource-discovery/a2a-editor",
                "@open-resource-discovery/mcp-server-card-ui",
                "@open-resource-discovery/overlay-editor",
                "@open-resource-discovery/ui-components",
                "@sap/csn-interop-renderer",
                "@scalar/api-reference-react",
                "@scalar/react-renderer",
                "@scalar/types"
            ],
            "automerge": false
        }
    ]
}
